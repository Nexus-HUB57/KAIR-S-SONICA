# Segurança: nunca versionar tokens reais.
# TikTok
KTD_TIKTOK_CLIENT_KEY=
KTD_TIKTOK_ACCESS_TOKEN=
KTD_TIKTOK_REFRESH_TOKEN=
KTD_TIKTOK_CLIENT_SECRET=
KTD_TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Instagram / Meta
KTD_META_APP_ID=
KTD_INSTAGRAM_ACCESS_TOKEN=
KTD_INSTAGRAM_USER_ID=
KTD_INSTAGRAM_APP_SECRET=
KTD_META_WEBHOOK_VERIFY_TOKEN=
KTD_INSTAGRAM_API_VERSION=v26.0
KTD_INSTAGRAM_GRAPH_BASE=https://graph.instagram.com

# LLM built-in proxy; habilitar somente em ambiente seguro.
KAIROS_SOCIAL_LLM_ENABLED=false
OPENAI_API_BASE=
OPENAI_API_KEY=

# Operação
KTD_SOCIAL_API_BASE_URL=
KTD_SOCIAL_EXECUTION_MODE=simulate
KTD_SOCIAL_PEER_MODE=optional
KTD_SOCIAL_WEBHOOK_TOLERANCE_SECONDS=300
