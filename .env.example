KAIROS_ENV=development
KAIROS_HOST=0.0.0.0
KAIROS_PORT=8000
KAIROS_OUTPUT_DIR=data/output
KAIROS_UPLOAD_DIR=data/uploads
KAIROS_TASK_DB_PATH=data/kairos_tasks.sqlite3
KAIROS_DEFAULT_SAMPLE_RATE=44100
KAIROS_FFMPEG_BIN=ffmpeg
KAIROS_TRANSCRIPTION_BACKEND=sidecar
KAIROS_TRANSCRIPTION_MODEL=small
KAIROS_TRANSCRIPTION_DEVICE=cpu
KAIROS_TRANSCRIPTION_COMPUTE_TYPE=int8
KAIROS_ENABLE_EXTERNAL_MODELS=false

# SkyReels-V2 opcional: mantenha desativado até validar GPU, licença e checkpoint.
KAIROS_ENABLE_SKYREELS=false
KAIROS_SKYREELS_REPO=/opt/models/SkyReels-V2
KAIROS_SKYREELS_MODEL_ID=/opt/models/SkyReels-V2/checkpoints/SkyReels-V2-DF-1.3B-540P
KAIROS_SKYREELS_NATIVE_MODEL_ID=/models/Skywork/SkyReels-V2-DF-1.3B-540P-Diffusers
KAIROS_SKYREELS_NATIVE_API=false
KAIROS_SKYREELS_DEVICE=cuda
KAIROS_SKYREELS_DTYPE=bfloat16
KAIROS_SKYREELS_CACHE_DIR=/models/.cache
KAIROS_SKYREELS_PYTHON=python3
KAIROS_SKYREELS_ALLOW_MODEL_DOWNLOAD=false
KAIROS_SKYREELS_TIMEOUT_SECONDS=3600

# Validação no host público NVIDIA/CUDA; não inicia probes externos sem opt-in.
KAIROS_GPU_API_URL=http://127.0.0.1:8000
KAIROS_REQUIRE_NATIVE_READY=true
KAIROS_RUN_EXTERNAL_PROBES=false
KAIROS_REQUIRE_LLAMAGEN_PROBE=false
KAIROS_FFPROBE_BIN=ffprobe
KAIROS_CORS_ORIGINS=http://localhost:8080
KAIROS_SKYREELS_KEEP_STAGING=false
KAIROS_SKYREELS_MAX_CONCURRENCY=1
# LTX-2 audiovisual sincronizado: opt-in somente após revisar licença, modelo e GPU.
KAIROS_LTX2_ENABLED=false
KAIROS_LTX2_REPO=/opt/models/LTX-2
KAIROS_LTX2_MODEL_ID=
KAIROS_LTX2_LICENSE_ACCEPTED=false
KAIROS_WORKER_MODE=inline
KAIROS_LOG_LEVEL=INFO
# Upload/handoff explícito do estúdio; deixe vazio para manter o endpoint desabilitado.
KAIROS_STUDIO_UPLOAD_TOKEN=
KAIROS_STUDIO_UPLOAD_MAX_BYTES=104857600
KAIROS_STUDIO_UPLOAD_MAX_DURATION_SECONDS=900
KAIROS_STUDIO_UPLOAD_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg,.webm
KAIROS_MEDIA_CACHE_DIR=data/media-cache
KAIROS_MEDIA_CACHE_MAX_BYTES=104857600
KAIROS_MEDIA_PROVIDER_ORDER=pexels,unsplash
# Provedores opcionais; mantenha vazios em desenvolvimento local.
PEXELS_API_KEY=
UNSPLASH_API_KEY=

# Núcleo complementar de planejamento/handoff; não substitui API, worker ou SkyReels.
KAIROS_AGENTIC_CORE_ENABLED=true
KAIROS_AGENTIC_MEMORY_DIR=data/agentic-memory
KAIROS_AGENTIC_EXTERNAL_TOOLS_ENABLED=false
KAIROS_ARTISTIC_ISLAND_ENABLED=true
KAIROS_INSTRUMENT_ATLAS_PATH=config/instrument_atlas.yaml
KAIROS_STUDIO_MASTER_ENABLED=true
KAIROS_CANON_INDEX_PATH=config/canon_index.yaml
KAIROS_INSTRUMENTATION_REPERTOIRE_PATH=config/instrumentation_repertoire.yaml
KAIROS_STUDIO_MASTER_MAX_INPUT_SAMPLES=250000
KAIROS_STUDIO_MASTER_MEMORY_ENABLED=false
KAIROS_STUDIO_MASTER_MEMORY_PATH=data/studio-master/artist-memory.jsonl
KAIROS_STUDIO_MASTER_AUTO_RETRAIN_ENABLED=false
KAIROS_STUDIO_MASTER_RETRAIN_MANIFEST_PATH=data/studio-master/retrain-manifest.json
KAIROS_STUDIO_MASTER_ANALYTICS_PATH=data/production_history.json
# Gate PHD: audita antes do worker e bloqueia identidade/voz/vídeo fora do cânone.
KAIROS_STUDIO_MASTER_AUTO_REVIEW_ENABLED=true
KAIROS_STUDIO_MASTER_PREFLIGHT_DIR=data/studio-master/preflight

# Fallback cloud opcional: desabilitado e não configurado até aprovar provider, licença, retenção e custo.
# A rota explícita é POST /v1/video/cloud-submit; planners/preflight nunca fazem fallback automático.
KAIROS_CLOUD_VIDEO_FALLBACK_ENABLED=false
KAIROS_CLOUD_VIDEO_FALLBACK_PROVIDER=NOT_CONFIGURED
KAIROS_CLOUD_VIDEO_FALLBACK_BASE_URL=
KAIROS_CLOUD_VIDEO_FALLBACK_SUBMIT_PATH=/v1/video/generations
KAIROS_CLOUD_VIDEO_FALLBACK_API_KEY_ENV=KAIROS_CLOUD_VIDEO_FALLBACK_API_KEY
KAIROS_CLOUD_VIDEO_FALLBACK_TIMEOUT_SECONDS=1800
KAIROS_CLOUD_VIDEO_FALLBACK_ALLOWED_PROVIDERS=
KAIROS_CLOUD_VIDEO_FALLBACK_LICENSE_ACKNOWLEDGED=false
KAIROS_CLOUD_VIDEO_FALLBACK_RETENTION_ACKNOWLEDGED=false
KAIROS_CLOUD_VIDEO_FALLBACK_SPENDING_LIMIT_CENTS=0
KAIROS_CLOUD_VIDEO_FALLBACK_MAX_UPLOAD_BYTES=104857600

# Núcleo complementar de planejamento/handoff; não substitui API, worker ou SkyReels.
KAIROS_COMPLEMENTARY_CORE_ENABLED=true

# Agregador externo de agentes/capacidades; mantenha desligado até revisar a origem.
KAIROS_AGENT_AGGREGATOR_ENABLED=false
KAIROS_SKYREELS_SPACE_ENABLED=false
KAIROS_SKYREELS_SPACE_BASE_URL=https://fffiloni-skyreels-v2.hf.space
KAIROS_SKYREELS_SPACE_ENDPOINT=generate_diffusion_forced_video
KAIROS_SKYREELS_SPACE_TIMEOUT_SECONDS=1800
KAIROS_LLAMAGEN_ENABLED=false
KAIROS_LLAMAGEN_BASE_URL=https://api.llamagen.ai
KAIROS_LLAMAGEN_API_KEY_ENV=LLAMAGEN_API_KEY
KAIROS_LLAMAGEN_TIMEOUT_SECONDS=60

# Adapters reais StudioMaster: desligados por padrão; habilite por ambiente após revisar licença, modelo e assets.
KAIROS_STUDIO_MASTER_REAL_ADAPTERS_ENABLED=false
KAIROS_STUDIO_MASTER_ADAPTER_LICENSES_PATH=config/studio_master_adapter_licenses.yaml
KAIROS_STUDIO_MASTER_ADAPTER_MODEL_MANIFEST_PATH=data/studio-master/model-manifest.json
KAIROS_STUDIO_MASTER_ADAPTER_ASSETS_DIR=data/approved-assets
KAIROS_STUDIO_MASTER_ADAPTER_OUTPUT_DIR=data/studio-master/adapter-output
KAIROS_STUDIO_MASTER_ACCEPTED_ADAPTER_LICENSES=
KAIROS_STUDIO_MASTER_ENABLED_ADAPTER_IDS=
# IDs possíveis: crepe,pedalboard,fluidsynth,demucs,mosnet,moviepy
# Caminhos de modelo/soundfont/plugin devem ficar fora do Git e ser informados por manifesto/ambiente.
