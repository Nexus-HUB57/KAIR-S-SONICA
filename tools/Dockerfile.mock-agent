FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY tools/mock_external_agent.py ./tools/mock_external_agent.py

HEALTHCHECK --interval=2s --timeout=3s --start-period=2s --retries=10 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/health', timeout=2)"
